# HackSync Production Environment Variables

# Client-Facing Supabase Public Credentials (Safe for browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Server-Only Privileged Credentials (NEVER expose to VITE_ or client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-secret-key

# Distributed Rate Limiting (Upstash / Redis REST API)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Optional Server-Side AI Intelligence Gateway Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
